{
  "manifest_version": 3,
  "name": "Braille Translator (English)",
  "short_name": "Braille",
  "description": "Translates web pages into braille.",
  "version": "2.0",
  "icons": {
    "128": "icon.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_icon": "icon.png",
    "default_title": "Braille: switch mode"
  }
}
